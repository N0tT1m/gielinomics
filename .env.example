# Copy to .env and fill in. .env is gitignored.

POSTGRES_PASSWORD=

# Required by the wiki. Must identify you and give them a way to make contact --
# they block a list of default agents outright, including RestSharp and curl.
# Quoted: the parentheses are a syntax error if you `source .env` from a shell.
WEATHERIA_USER_AGENT="weatheria/0.1 (github.com/N0tT1m/weatheria)"

# One-shot daily backfill. Enable for a single overnight run, then set back to false.
WEATHERIA_RUN_BACKFILL=false

GRAFANA_PASSWORD=
