<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- This project must not reference any other project in the solution.
         It is a standalone package that happens to have this repo as its first consumer. -->
    <PackageId>Gielinomics.Osrs.Client</PackageId>
    <Version>0.1.0-alpha</Version>
    <Description>Typed async .NET client for the Old School RuneScape wiki real-time prices API (v2), the official hiscores, and Wise Old Man.</Description>
    <PackageTags>osrs;runescape;grand-exchange;prices;hiscores;api-client</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lua literal quoting is an internal detail, but it is also the escaping that stops an
         item name with an apostrophe becoming a syntax error in evaluated code. Worth testing
         directly rather than only through the queries that happen to exercise it. -->
    <InternalsVisibleTo Include="Gielinomics.Client.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="9.0.0" />
  </ItemGroup>

</Project>
