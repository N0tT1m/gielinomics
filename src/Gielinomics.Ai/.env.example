# Copy to .env and fill in. .env is gitignored.
# Everything runs on your own hardware -- no hosted API, no API key.

# Required. The wiki blocks default agents outright, so this is not advisory.
# Must identify you and give the wiki a way to make contact.
RELDO_USER_AGENT="gielinomics/0.1 (github.com/N0tT1m/gielinomics)"

# --- the Gielinomics platform ----------------------------------------------
# Set this and the GE and hiscores clients read from the C# side of this repo
# -- TimescaleDB, with the price bars and hiscore snapshots the ingest workers
# have been accumulating -- instead of from the wiki and Jagex directly.
#
# That is what makes "has the whip been rising" answerable: the upstream APIs
# answer only what is true right now and keep no history to answer it from.
#
# Leave it empty and every client points upstream, exactly as before. Inside
# the compose network the API answers on the container name, not localhost.
RELDO_GIELINOMICS_URL=http://api:8080
# Only needed to enrol an account for tracking, which is authenticated. Without
# it the AI can read every tracked account but cannot add one.
RELDO_GIELINOMICS_TOKEN=
# Ask the wiki when the platform cannot answer. On by default: a database that
# is down should cost you the history, not the price. Turn it off to make a
# misconfigured URL fail loudly rather than silently go slow.
RELDO_GIELINOMICS_FALLBACK=true
# Enrol accounts the platform has never seen when somebody asks about them. The
# first answer still comes from Jagex; the point is that next week's arrives
# with history attached. Needs RELDO_GIELINOMICS_TOKEN.
RELDO_GIELINOMICS_TRACK=true

# --- local model serving (goose = 192.168.1.78, the 5090 box) ---------------
RELDO_AI_BACKEND=ollama
RELDO_OLLAMA_API_URL=http://192.168.1.78:11434

# Mistral Small 3.2 @ Q6_K -- ~20 GB vs qwen3:32b's 28.6 GB, leaving headroom on
# a 32 GB card. Measured tool-calling support on this box:
#   qwen3:32b             YES     mistral-small3.2:24b   YES
#   qwen2.5:7b-instruct   YES     gemma3:27b             NO (HTTP 400)
#   dolphin3:8b           NO      hermes3:8b             NO (emits <SCRATCHPAD>)
#   qwen3-coder:30b       NO (emits <.tools> as plain text)
# A model that cannot tool-call does not error -- it just never searches.
# Always run `reldo doctor` after changing this.
RELDO_OLLAMA_MODEL=hf.co/unsloth/Mistral-Small-3.2-24B-Instruct-2506-GGUF:Q6_K

# vLLM alternative (nothing was listening on goose when this was written).
# RELDO_AI_BACKEND=vllm
# RELDO_VLLM_API_URL=http://192.168.1.78:8002/v1
# RELDO_VLLM_MODEL=Qwen2.5-32B-Instruct-Q6_K

# --- embeddings -------------------------------------------------------------
# ollama = GPU, 768-dim, ~1.6 min to index the wiki.
# local  = CPU ONNX fallback, 384-dim, ~13 min. Needs no GPU box.
# The two produce incompatible vectors: changing this requires a rebuild.
RELDO_EMBED_BACKEND=ollama
RELDO_OLLAMA_EMBED_MODEL=nomic-embed-text

# --- tracing via den-den-mushi ----------------------------------------------
# Off by default. Set the proxy URL and every prompt, response, and tool call
# reldo makes is recorded locally and searchable by agent tag -- which is the
# only way to answer "what did the model actually see" after a bad answer.
#
#   cd ~/workspace/network-tools/den-den-mushi && ./bin/denden server
#
# Point it at the PROXY port (8443), not the hub UI port (8765). Only chat is
# routed; embeddings keep going straight to Ollama on purpose, because a wiki
# rebuild would otherwise bury the traces you want under ~85k embed calls.
#
# denden's own `default_upstream` decides which box the call lands on, so it
# must match RELDO_OLLAMA_API_URL above -- otherwise you trace calls to a
# different GPU than the one you think you're using. `reldo doctor` verifies
# the whole path end to end and prints both addresses when it can't.
# RELDO_TRACE_PROXY_URL=http://127.0.0.1:8443
# RELDO_TRACE_AGENT=reldo
# RELDO_TRACE_HUB_URL=http://127.0.0.1:8765
# Only if you run more than one model box AND named it in denden's config. A
# name denden doesn't recognise 502s every call, and "default" is not a valid
# name -- leave this unset to use denden's default upstream.
# RELDO_TRACE_UPSTREAM=goose

# Required only for `reldo bot`.
RELDO_DISCORD_TOKEN=

# Sync /wiki to one server instead of globally. Strongly recommended:
# a global sync takes up to an hour to show up, and a missing /wiki looks
# identical to a broken bot. Enable Developer Mode in Discord, then
# right-click your server -> Copy Server ID.
# RELDO_DISCORD_GUILD_ID=

# -- account links and voice (Discord only) ---------------------------------
# Where /link keeps Discord user -> RuneScape name. One string per user.
RELDO_ACCOUNTS_PATH=data/accounts.json

# Bot tone. No characters ship with this repository -- 'plain' is the only
# persona defined, and any other name resolves to it. The hook is kept so that
# a voice added later inherits the grounding clause instead of bypassing it;
# see src/reldo/persona.py. Applies ONLY in the channels listed below, so a
# voice cannot follow the bot into every general channel it can see.
# RELDO_PERSONA=plain
# RELDO_PERSONA_CHANNEL_IDS=123456789012345678,987654321098765432

# -- live game state from the RuneLite plugin -------------------------------
# The plugin POSTs here; nothing reaches into the game the other way.
# 127.0.0.1 if RuneLite runs on this same machine.
RELDO_LIVE_ENABLED=false
RELDO_LIVE_HOST=127.0.0.1
RELDO_LIVE_PORT=8099
# Must match the plugin's token. Leave empty only on loopback.
RELDO_LIVE_TOKEN=
